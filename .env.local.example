# ─────────────────────────────────────────────────────────────────
#  ENVIRONMENT VARIABLES — copy this file to .env.local
#  cp .env.local.example .env.local
# ─────────────────────────────────────────────────────────────────

# ── GitHub Integration (REQUIRED for GitHub section) ─────────────
# Create a Personal Access Token at:
# https://github.com/settings/tokens/new
# Scopes needed: read:user, public_repo
GITHUB_TOKEN=your_github_personal_access_token_here

# Your GitHub username (public, safe to expose)
NEXT_PUBLIC_GITHUB_USERNAME=dhiyaulhaq

# ── Wakatime (OPTIONAL) ──────────────────────────────────────────
# Your Wakatime username (must have public stats enabled)
# Enable at: https://wakatime.com/settings/account → Public Profile
NEXT_PUBLIC_WAKATIME_USERNAME=dhiyaulhaq

# ── Availability Status (OPTIONAL) ───────────────────────────────
# Controls the "Open to internship" badge in Hero
# Values: "available" | "busy" | "hidden"
NEXT_PUBLIC_AVAILABILITY=available

# ─────────────────────────────────────────────────────────────────
#  DEPLOYMENT (Vercel)
#  vercel env add GITHUB_TOKEN
#  vercel env add NEXT_PUBLIC_GITHUB_USERNAME
# ─────────────────────────────────────────────────────────────────
